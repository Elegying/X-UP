<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Vendor/CDN keys rotate outside our control. Retain platform TLS checks. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
